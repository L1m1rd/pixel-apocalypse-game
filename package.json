{
  "name": "pixel-apocalypse-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Current pixel survival game visuals: six original survivors, 18 infected, environment, effects and 24 weapons",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node tools/launch-desktop.cjs",
    "prepare:desktop": "node tools/prepare-desktop-assets.cjs",
    "build:desktop": "node tools/package-desktop.cjs",
    "build:web": "node tools/build-web.cjs",
    "test:web": "node tools/test-web.cjs",
    "package:desktop": "node tools/package-northern-dachas-release.cjs",
    "test:desktop-core": "node --test desktop/core.test.mjs",
    "check:assets": "node tools/check-asset-files.cjs",
    "check:redesigned": "node tools/check-redesigned-animations.cjs",
    "check:combat-vfx": "node tools/check-combat-vfx.cjs",
    "inventory": "node tools/check-asset-files.cjs --inventory",
    "build:redesigned": "node tools/build-redesigned-animations.cjs",
    "build:combat-vfx": "node tools/build-combat-vfx.cjs",
    "build:environment": "node tools/build-environment-variants.cjs",
    "build:friends": "node tools/build-friends-animations.cjs",
    "build:weapons": "node tools/build-weapon-animations.cjs",
    "check:weapons": "node tools/check-weapon-animations.cjs",
    "package:weapons": "node tools/package-weapon-animations.cjs",
    "build:items": "node tools/build-item-revision.cjs",
    "check:items": "node tools/check-item-revision.cjs",
    "package:items": "node tools/package-item-revision.cjs",
    "build:wildlife": "node tools/build-wildlife-animations.cjs",
    "check:wildlife": "node tools/check-wildlife-animations.cjs",
    "preview:wildlife": "node tools/serve-wildlife-animations.cjs",
    "package:wildlife": "node tools/build-wildlife-animations.cjs --zip",
    "build:wildlife-loot": "node tools/build-wildlife-loot.cjs",
    "check:wildlife-loot": "node tools/check-wildlife-loot.cjs",
    "preview:wildlife-loot": "node tools/serve-wildlife-loot.cjs",
    "package:wildlife-loot": "node tools/build-wildlife-loot.cjs --zip",
    "prepare:items": "node tools/prepare-item-revision.cjs",
    "check:consistency": "node tools/check-asset-consistency.cjs",
    "reconcile:assets": "node tools/reconcile-assets.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "jszip": "3.10.1",
    "playwright": "1.62.1",
    "sharp": "0.35.5"
  }
}
